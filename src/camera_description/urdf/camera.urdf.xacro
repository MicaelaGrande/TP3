<?xml version="1.0"?>
<robot name="camera_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Frame de proyección en el suelo -->
    <link name="base_footprint" />

    <!-- Link principal con tu archivo .stl -->
    <link name="base_link">
        <visual>
            <geometry>
                <mesh filename="package://camera_description/meshes/base.stl" scale="1.0 1.0 1.0"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </visual>
    </link>

    <!-- Joint que conecta ambos para que robot_state_publisher publique el /tf -->
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

</robot>